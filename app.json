{
  "expo": {
    "name": "EcoLoop",
    "slug": "EcoLoop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ecoloop/icon.png",
    "scheme": "ecoloop",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F4ED",
        "foregroundImage": "./assets/ecoloop/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/ecoloop/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F4ED",
          "image": "./assets/ecoloop/icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "EcoLoop potrzebuje dostępu do wybranego zdjęcia, aby dodać je do ogłoszenia.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "EcoLoop używa Twojej lokalizacji tylko po naciśnięciu przycisku, aby pokazać pozycję na mapie.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
